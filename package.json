{
  "name": "@netbaan/ui",
  "version": "0.0.1",
  "type": "module",
  "description": "AEGIS design system — sealed, immutable React component library.",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "catalog.json",
    "CATALOG.md",
    "AGENTS.md",
    "RECIPES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build:js": "bunchee -m --no-sourcemap",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify && cp src/fonts.css dist/fonts.css",
    "build:catalog": "node .agent/scripts/build-catalog.mjs",
    "build": "npm run gen:barrel && npm run build:js && npm run build:css && npm run build:catalog",
    "prepack": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "gen:barrel": "node .agent/scripts/build-barrel.mjs",
    "verify:conformance": "node .agent/scripts/verify-conformance.mjs",
    "verify:tokens": "node .agent/scripts/verify-tokens.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:conformance && npm run verify:tokens",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10",
    "@fontsource-variable/geist": "^5.2.9",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "bunchee": "^6.12.2",
    "chromatic": "^16.10.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.2",
    "globals": "^17",
    "lucide-react": "^1.25.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.1",
    "storybook": "^10.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.10"
  }
}
